# Cấu hình Cơ sở dữ liệu PostgreSQL (Thay thế thông tin đăng nhập của bạn)
DATABASE_URL="postgresql://username:password@localhost:5432/dbname?schema=public"

# Cấu hình Server
PORT=5000
NODE_ENV=development

# Cấu hình JWT Authentication (Thay thế bằng khóa bí mật ngẫu nhiên bảo mật hơn)
JWT_SECRET="your_jwt_secret_key_here"

# Cấu hình Google Gemini API Key (Lấy từ Google AI Studio)
GEMINI_API_KEY="your_google_gemini_api_key_here"
